# Copy to .env.local and fill in. Never commit .env.local.

# SQLite database file (local-first)
DATABASE_URL=file:./data/jyotish.db

# Owner passcode hash (argon2id). Only needed if the app is reachable beyond localhost.
# Generate with: npm run passcode:hash
OWNER_PASSCODE_HASH=
SESSION_SECRET=

# AI assistant (optional, server-only). Leave blank to keep AI off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
